{
  "name": "world-holidays",
  "version": "0.1.0",
  "description": "Public holidays for every country, current and next year. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./country/*": {
      "import": {
        "types": "./dist/countries/*.d.ts",
        "default": "./dist/countries/*.js"
      },
      "require": {
        "types": "./dist/countries/*.d.cts",
        "default": "./dist/countries/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DATA_LICENSE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "(MIT AND CC-BY-SA-3.0)",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "holidays",
    "public-holidays",
    "countries",
    "calendar"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "date-holidays": "^3.38.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
